<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>14.0</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- В 4.8 библиотека .NET без пометок о null: те же проверки уже идут в сборке под net10.0. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8619;CS8620;CS8625;CA1416</NoWarn>
  </PropertyGroup>

  <!--
    Программы на ПК клуба собираются ещё и под .NET Framework 4.8 (docs/roadmap/netfx48.md): он встроен в
    Windows 10 и 11 и ставится на Windows 7, поэтому установщику не нужно возить свой .NET. Недостающее в
    4.8 добирают пакеты-заплатки на уровне исходников (Polyfill) и библиотеки, которые сами ходят на 4.8.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.13" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Compat/*.cs" Link="Compat/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
