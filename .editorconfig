root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,xaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[tests/**.cs]
# xUnit v3 просит передавать TestContext.Current.CancellationToken в каждый вызов с токеном.
# Тесты держат такие вызовы по всему набору (~7,8 тыс. мест); отмена прогона их не касается,
# поэтому правило здесь только подсказка, а не ошибка при TreatWarningsAsErrors.
dotnet_diagnostic.xUnit1051.severity = suggestion
