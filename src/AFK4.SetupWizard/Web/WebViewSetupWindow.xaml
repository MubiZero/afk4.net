<Window x:Class="AFK4.SetupWizard.Web.WebViewSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AFK4.NET Setup Wizard"
        Width="1100"
        Height="740"
        MinWidth="960"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="#EEF2F7">
        <wv2:WebView2 x:Name="Browser"
                      DefaultBackgroundColor="#EEF2F7" />

        <Border x:Name="StartupOverlay"
                Background="#EEF2F7"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                BorderBrush="#D8E0EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="StatusTitle"
                           Text="AFK4.NET Setup Wizard"
                           Foreground="#0F172A"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Margin="0,12,0,0"
                           Text="Загрузка мастера настройки..."
                           Foreground="#475569"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
