<Window x:Class="AFK4.SetupWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK4 Setup Wizard"
        Width="760"
        Height="620"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="AFK4 Setup Wizard" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="https://afk4.staging.mubi.dev" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource PanelBrush}"
                    Padding="12,8"
                    CornerRadius="6"
                    HorizontalAlignment="Right">
                <Grid>
                    <TextBlock x:Name="StepLabel" FontWeight="SemiBold" />
                    <Button x:Name="DoneButton"
                            Content="Done"
                            MinWidth="52"
                            Padding="8,3"
                            Visibility="Collapsed"
                            Click="Done_OnClick" />
                </Grid>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Border x:Name="OwnerCodePanel" Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Owner code" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Enter the 8 digit code from the club dashboard." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />
                    <TextBox x:Name="OwnerCodeBox"
                             Text="{Binding OwnerCode, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="28"
                             MaxLength="16"
                             Width="260"
                             HorizontalAlignment="Left"
                             CharacterCasing="Upper"
                             HorizontalContentAlignment="Center" />
                    <Button Content="Discover branches"
                            Style="{StaticResource StepButton}"
                            Width="170"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Left"
                            Click="Discover_OnClick" />
                </StackPanel>
            </Border>

            <Border x:Name="BranchPanel" Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="8" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Branch" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the branch for this PC." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox x:Name="BranchList"
                             ItemsSource="{Binding Branches}"
                             DisplayMemberPath="Name"
                             MinHeight="260"
                             SelectionChanged="BranchList_OnSelectionChanged" />
                </DockPanel>
            </Border>

            <Border x:Name="SeatPanel" Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="8" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Seat" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Free seats are selectable; occupied seats stay locked." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBox x:Name="NewSeatNameBox"
                                 Grid.Column="1"
                                 Width="140"
                                 Height="34"
                                 VerticalAlignment="Bottom"
                                 Margin="12,0,8,0" />
                        <Button Grid.Column="2"
                                Content="Add seat"
                                Height="34"
                                VerticalAlignment="Bottom"
                                Click="CreateSeat_OnClick" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Seats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinWidth="112"
                                            MinHeight="74"
                                            Margin="0,0,10,10"
                                            Padding="10"
                                            IsEnabled="{Binding IsSelectable}"
                                            Tag="{Binding}"
                                            Click="Seat_OnClick">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#DDF5E8" />
                                                <Setter Property="BorderBrush" Value="#1F7A4D" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Setter Property="BorderBrush" Value="#A0A6B1" />
                                                        <Setter Property="Foreground" Value="#667085" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ZoneName}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="RolePanel" Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Role" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Name this PC and choose what AFK4 should install after enrollment." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />
                    <TextBlock Text="Display name" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left" Margin="0,4,0,16" />
                    <RadioButton x:Name="GamingPcRadio" Content="Gaming PC" IsChecked="True" Margin="0,0,0,8" Checked="Role_OnChecked" />
                    <RadioButton x:Name="ManagerRadio" Content="Manager workstation" Checked="Role_OnChecked" />
                    <Button x:Name="ChooseSeatButton"
                            Content="Choose seat"
                            Style="{StaticResource StepButton}"
                            Width="120"
                            Margin="0,22,0,0"
                            HorizontalAlignment="Left"
                            Click="ChooseSeat_OnClick" />
                    <Button x:Name="EnrollButton"
                            Content="Enroll"
                            Style="{StaticResource StepButton}"
                            Width="120"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="Enroll_OnClick" />
                </StackPanel>
            </Border>

            <Border x:Name="FinishedPanel" Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Finished" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="12" Background="#FFF9E7" CornerRadius="6" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="#A33A2A" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
