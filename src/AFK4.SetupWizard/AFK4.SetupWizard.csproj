<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.SetupWizard.Core\AFK4.SetupWizard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <!-- Фронтенд мастера линкуется прямо из dist соседнего проекта — так же, как в оболочке
       игрока. Раньше в репозитории лежала собранная копия под WebAssets/, и она молча
       устаревала: запуск не через релизный скрипт показывал мастер трёхмесячной давности,
       без половины экранов, и ничем себя не выдавал. Чистая копия без dist теперь просто ни
       с чем не совпадает, и мастер честно говорит, что фронтенд не собран. -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\AFK4.SetupWizard.Web\dist\**\*">
      <Link>WebAssets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Светлая/тёмная иконка окна для рантайм-переключения при смене темы (см.
         WebViewSetupWindow.TryHandleWindowMessage "window:theme") — отдельно от
         ApplicationIcon, который лишь статичная иконка exe/ярлыка. -->
    <Resource Include="Assets\afk4-icon-light.png" />
    <Resource Include="Assets\afk4-icon-dark.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AFK4.SetupWizard</AssemblyName>
    <!-- Embeds the AFK4.NET logo into the exe so both the desktop/Start Menu shortcuts (which
         target the exe) and the window/taskbar show the brand icon instead of the generic default. -->
    <ApplicationIcon>afk4-setupwizard.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WebView2 SDK новее 1.0.1518 не запускается на Windows 7: сборка под .NET Framework 4.8 — для неё. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1518.46" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
