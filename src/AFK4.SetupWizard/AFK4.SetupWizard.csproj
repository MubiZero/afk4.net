<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.SetupWizard.Core\AFK4.SetupWizard.Core.csproj" />
    <ProjectReference Include="..\AFK4.WebHost\AFK4.WebHost.csproj" />
  </ItemGroup>

  <!-- Фронтенд мастера линкуется прямо из dist соседнего проекта — так же, как в оболочке
       игрока. Раньше в репозитории лежала собранная копия под WebAssets/, и она молча
       устаревала: запуск не через релизный скрипт показывал мастер трёхмесячной давности,
       без половины экранов, и ничем себя не выдавал. Чистая копия без dist теперь просто ни
       с чем не совпадает, и мастер честно говорит, что фронтенд не собран. -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\AFK4.SetupWizard.Web\dist\**\*">
      <Link>WebAssets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Мастер — один файл машинного кода без .NET на Windows 7–11, x86 и x64 (Native AOT), окно — Win32 + Miniblink
    (AFK4.WebHost) вместо WPF и WebView2: docs/roadmap/windows7.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <AssemblyName>AFK4.SetupWizard</AssemblyName>
    <!-- Логотип AFK4.NET в exe: его показывают ярлыки, окно и панель задач. -->
    <ApplicationIcon>afk4-setupwizard.ico</ApplicationIcon>
  </PropertyGroup>

  <Import Project="..\AFK4.WebHost\Miniblink.targets" />
</Project>
