    "@afk4/tokens": "workspace:*",
    "@afk4/ui": "workspace:*",
    "@microsoft/signalr": "^10.0.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
