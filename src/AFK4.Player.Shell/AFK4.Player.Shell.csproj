<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.Shared.Contracts\AFK4.Shared.Contracts.csproj" />
    <ProjectReference Include="..\AFK4.Localization\AFK4.Localization.csproj" />
    <ProjectReference Include="..\AFK4.Localization.Wpf\AFK4.Localization.Wpf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPlayerWebAssets" BeforeTargets="Build">
    <ItemGroup>
      <PlayerWebDist Include="$(MSBuildProjectDirectory)\..\AFK4.Player.Shell.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerWebDist)"
          DestinationFiles="@(PlayerWebDist->'$(OutDir)WebAssets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PlayerWebDist)' != ''" />
  </Target>

</Project>
