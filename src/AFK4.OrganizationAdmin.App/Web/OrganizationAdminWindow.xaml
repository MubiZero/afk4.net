<Window x:Class="AFK4.OrganizationAdmin.Web.OrganizationAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Organization Admin"
        Width="1152"
        Height="840"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#0E1117">
        <wv2:WebView2 x:Name="Browser"
                      DefaultBackgroundColor="#0E1117" />

        <Border x:Name="StartupOverlay"
                Background="#0E1117"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                BorderBrush="#2B3545"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="StatusTitle"
                           Text="Organization Admin"
                           Foreground="#F5F7FA"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Margin="0,12,0,0"
                           Text="Loading operator workspace..."
                           Foreground="#AAB4C2"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
