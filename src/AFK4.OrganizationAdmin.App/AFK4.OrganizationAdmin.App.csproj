<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.Shared.Contracts\AFK4.Shared.Contracts.csproj" />
    <ProjectReference Include="..\AFK4.Localization\AFK4.Localization.csproj" />
    <ProjectReference Include="..\AFK4.WebHost\AFK4.WebHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Панель — один файл машинного кода без .NET на Windows 7–11, x86 и x64 (Native AOT), окно — Win32 + Miniblink
    (AFK4.WebHost) вместо WPF и WebView2: docs/roadmap/windows7.md. DLL Miniblink своей разрядности лежит рядом с exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <!-- Embeds the AFK4.NET logo into the exe so both the desktop and Start Menu shortcuts (which
         target the exe) and the window/taskbar show the brand icon instead of the generic default. -->
    <ApplicationIcon>afk4-operator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (подключение к клубу и ключ офлайн-аренд): на Windows 7 работает так же, как на 11. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <Import Project="..\AFK4.WebHost\Miniblink.targets" />
</Project>
