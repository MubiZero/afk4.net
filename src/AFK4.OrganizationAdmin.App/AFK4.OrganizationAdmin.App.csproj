<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.Shared.Contracts\AFK4.Shared.Contracts.csproj" />
    <ProjectReference Include="..\AFK4.Localization\AFK4.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Светлая/тёмная иконка окна для рантайм-переключения при смене темы (см.
         OrganizationAdminWindow.TryHandleWindowMessage "window:theme") — отдельно от
         ApplicationIcon, который лишь статичная иконка exe/ярлыка. -->
    <Resource Include="Assets\afk4-icon-light.png" />
    <Resource Include="Assets\afk4-icon-dark.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Embeds the AFK4.NET logo into the exe so both the desktop and Start Menu shortcuts (which
         target the exe) and the window/taskbar show the brand icon instead of the generic default. -->
    <ApplicationIcon>afk4-operator.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WebView2 SDK новее 1.0.1518 не запускается на Windows 7: сборка под .NET Framework 4.8 — для неё. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1518.46" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
