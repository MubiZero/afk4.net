<Window x:Class="AFK4.Operator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:AFK4.Operator.App.Shell"
        Title="{Binding Title}"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1040"
        Background="#F3F5F7">
    <Grid>
        <Grid Background="#111827">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420"
                    Padding="28"
                    Background="White"
                    BorderBrush="#D8DEE9"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel DataContext="{Binding SignIn}">
                    <TextBlock Text="AFK4 Operator"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Operator sign-in"
                               Margin="0,6,0,22"
                               Foreground="#4B5563" />

                    <TextBlock Text="Organization"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="User"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="Password"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,18" />

                    <Button Content="Sign In"
                            Height="36"
                            Command="{Binding SignInCommand}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,14,0,0"
                               Foreground="#047857"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,8,0,0"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel LastChildFill="True">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Top"
                    Background="#111827"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,18,0" />
                        <TextBlock Text="User"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,4,0" />
                        <TextBlock Text="{Binding CurrentUser.DisplayName}"
                                   Foreground="#F9FAFB"
                                   FontWeight="SemiBold"
                                   Margin="0,2,16,0" />
                        <TextBlock Text="Branch"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,4,0" />
                        <TextBlock Text="{Binding BranchSummary}"
                                   Foreground="#F9FAFB"
                                   Margin="0,2,16,0" />
                        <TextBlock Text="Shift"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,4,0" />
                        <TextBlock Text="{Binding CurrentShiftState}"
                                   Foreground="#A7F3D0"
                                   Margin="0,2,16,0" />
                        <TextBlock Text="Realtime"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,4,0" />
                        <TextBlock Text="{Binding RealtimeConnectionState}"
                                   Foreground="#BFDBFE"
                                   Margin="0,2,16,0" />
                    </WrapPanel>

                    <Button Grid.Column="1"
                            Content="Sign Out"
                            Command="{Binding SignOutCommand}"
                            MinWidth="92"
                            Padding="12,6" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="0,1,0,0"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#374151"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right">
                        <TextBlock Text="{Binding FloorMap.ErrorMessage}"
                                   Foreground="#B91C1C"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding FloorMap.SeatContext.ErrorMessage}"
                                   Foreground="#B91C1C"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Players.ErrorMessage}"
                                   Foreground="#B91C1C"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Pos.ErrorMessage}"
                                   Foreground="#B91C1C"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Shifts.ErrorMessage}"
                                   Foreground="#B91C1C"
                                   Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Background="#E5E7EB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="0,0,1,0"
                        Padding="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Workspaces"
                                   Foreground="#4B5563"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,10" />
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Kind}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            Padding="10,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1"
                      Margin="14">
                    <Grid DataContext="{Binding FloorMap}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.FloorMap}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding BranchName}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding Seats.Count, StringFormat={}{0} seats}"
                                           Foreground="#4B5563"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Padding="14,7" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Seats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.FloorMap.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,10,10"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Border Width="154"
                                                    Height="104"
                                                    Background="White"
                                                    BorderBrush="#D8DEE9"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827" />
                                                    <TextBlock Text="{Binding Zone}"
                                                               Margin="0,4,0,0"
                                                               Foreground="#4B5563" />
                                                    <TextBlock Text="{Binding State}"
                                                               Margin="0,10,0,0"
                                                               FontWeight="SemiBold"
                                                               Foreground="#047857" />
                                                    <TextBlock Text="{Binding RemainingSeconds, TargetNullValue=''}"
                                                               Foreground="#6B7280" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid DataContext="{Binding Pos}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Pos}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="2"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="POS"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding CartSummary}"
                                           Foreground="#4B5563"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Load Catalog"
                                    Command="{Binding RefreshCatalogCommand}"
                                    Padding="14,7" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CatalogGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Products}"
                                                          Tag="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Grid}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,8,8"
                                                                Padding="10"
                                                                Width="180"
                                                                HorizontalContentAlignment="Stretch">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#111827"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Price.MinorUnits, StringFormat={}{0} minor units}"
                                                                           Foreground="#4B5563"
                                                                           Margin="0,4,0,0" />
                                                                <TextBlock Text="{Binding StockOnHand, StringFormat=Stock {0}}"
                                                                           Foreground="#6B7280"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="12"
                                Margin="14,0,0,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Text="{Binding PendingOperation}"
                                               Foreground="#92400E"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Margin="0,6,0,0"
                                               Foreground="#047857"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Margin="0,6,0,0"
                                               Foreground="#B91C1C"
                                               TextWrapping="Wrap" />
                                    <Button Content="Cash"
                                            Command="{Binding PayCashCommand}"
                                            Margin="0,10,0,0"
                                            Height="32" />
                                    <Button Content="Card Manual"
                                            Command="{Binding PayCardManualCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <Button Content="Refund Last"
                                            Command="{Binding RefundLastSaleCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <Button Content="Void Draft"
                                            Command="{Binding VoidDraftSaleCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Cart"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <ListBox ItemsSource="{Binding CartLines}"
                                             Margin="0,10,0,10"
                                             BorderBrush="#D8DEE9"
                                             BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827" />
                                                        <TextBlock Text="{Binding Quantity, StringFormat=Qty {0}}"
                                                                   Foreground="#4B5563" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding LineTotalMinorUnits}"
                                                               Foreground="#111827"
                                                               FontWeight="SemiBold"
                                                               Margin="10,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding CartTotalMinorUnits, StringFormat=Total {0} minor units}"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="{Binding CurrentShiftId, TargetNullValue='No open shift for POS.'}"
                                               Margin="0,6,0,0"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid DataContext="{Binding Players}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Players}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     MinHeight="32" />
                            <Button Content="Search"
                                    Command="{Binding SearchCommand}"
                                    Margin="8,0,0,0"
                                    MinWidth="92" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                                 BorderBrush="#D8DEE9"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   Foreground="#4B5563" />
                                        <TextBlock Text="{Binding BalanceSummary}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#047857" />
                                        <TextBlock Text="{Binding PackageSummary}"
                                                   Foreground="#4B5563" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="14,0,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Player"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding SelectedPlayer.DisplayName, TargetNullValue='No player selected.'}"
                                           Margin="0,8,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding WalletSummaryText}"
                                           Margin="0,4,0,0"
                                           Foreground="#4B5563" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshSelectedPlayerCommand}"
                                        Margin="0,10,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Create player"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBox Text="{Binding NewPlayerDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewPlayerPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Create"
                                        Command="{Binding CreatePlayerCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Wallet"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBox Text="{Binding TopUpAmountMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Top Up"
                                        Command="{Binding TopUpWalletCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />
                                <TextBox Text="{Binding DebtPaymentAmountMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0" />
                                <TextBox Text="{Binding MoneyReason, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Pay Debt"
                                        Command="{Binding PayDebtCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <ItemsControl ItemsSource="{Binding PlayerPackages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827" />
                                                <TextBlock Text="{Binding RemainingSummary}"
                                                           Foreground="#4B5563" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding PendingOperation}"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#B91C1C"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid DataContext="{Binding Shifts}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Shifts}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Shifts"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding CurrentShiftState, TargetNullValue='No open shift'}"
                                           Foreground="#4B5563"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Load Current"
                                    Command="{Binding LoadCurrentShiftCommand}"
                                    Padding="14,7" />
                        </Grid>

                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Open"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Starting cash"
                                           Margin="0,10,0,0"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding StartingCashMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <TextBlock Text="Opening note"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding OpeningNote, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <Button Content="Open Shift"
                                        Command="{Binding OpenShiftCommand}"
                                        Height="32" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Cash Movement"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Amount"
                                           Margin="0,10,0,0"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding CashMovementAmountMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <TextBlock Text="Type"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding CashMovementType, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <TextBlock Text="Reason"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding CashMovementReason, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <Button Content="Record"
                                        Command="{Binding RecordCashMovementCommand}"
                                        Height="32" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Close"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding ExpectedCashMinorUnits, StringFormat=Expected {0}}"
                                           Margin="0,10,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="Counted cash"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding CountedCashMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <TextBlock Text="Closing note"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,8" />
                                <Button Content="Close Shift"
                                        Command="{Binding CloseShiftCommand}"
                                        Height="32" />
                                <TextBlock Text="{Binding DifferenceMinorUnits, StringFormat=Difference {0}}"
                                           Margin="0,10,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding PendingOperation}"
                                           Margin="0,10,0,0"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#B91C1C"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="From UTC"
                                                   Foreground="#4B5563" />
                                        <TextBox Text="{Binding ReportFromUtcText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="To UTC"
                                                   Foreground="#4B5563" />
                                        <TextBox Text="{Binding ReportToUtcText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="Limit"
                                                   Foreground="#4B5563" />
                                        <TextBox Text="{Binding ReportLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="Load Reports"
                                            Command="{Binding LoadReportsCommand}"
                                            Padding="14,7"
                                            VerticalAlignment="Bottom" />
                                    <WrapPanel Grid.Column="4"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom">
                                        <Button Content="Export Shifts"
                                                Command="{Binding ExportShiftReportCsvCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,7" />
                                        <Button Content="Export Sales"
                                                Command="{Binding ExportSalesReportCsvCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,7" />
                                        <Button Content="Export Time"
                                                Command="{Binding ExportGameplayTimeReportCsvCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,7" />
                                        <Button Content="Export Cash"
                                                Command="{Binding ExportCashOperationReportCsvCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,7" />
                                        <Button Content="Export Actions"
                                                Command="{Binding ExportOperatorActionReportCsvCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,7" />
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,12,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ShiftReportSummary}"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SalesReportSummary}"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding GameplayTimeReportSummary}"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding CashOperationReportSummary}"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding OperatorActionReportSummary}"
                                               Foreground="#4B5563"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid ItemsSource="{Binding ShiftReportRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="150"
                                              Margin="0,0,8,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Shift" Binding="{Binding ShiftId}" Width="80" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                            <DataGridTextColumn Header="Opened" Binding="{Binding OpenedAtUtc}" Width="120" />
                                            <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash}" Width="110" />
                                            <DataGridTextColumn Header="Counted" Binding="{Binding CountedCash}" Width="110" />
                                            <DataGridTextColumn Header="Diff" Binding="{Binding Difference}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DataGrid Grid.Column="1"
                                              ItemsSource="{Binding SalesReportRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="150">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sale" Binding="{Binding PosSaleId}" Width="80" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="120" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100" />
                                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount}" Width="100" />
                                            <DataGridTextColumn Header="Refund" Binding="{Binding RefundAmount}" Width="100" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding ItemQuantity}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="1"
                                          Grid.ColumnSpan="2"
                                          Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DataGrid ItemsSource="{Binding GameplayTimeReportRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  MinHeight="130"
                                                  Margin="0,0,8,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="80" />
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                                                <DataGridTextColumn Header="Started" Binding="{Binding StartedAtUtc}" Width="120" />
                                                <DataGridTextColumn Header="Secs" Binding="{Binding DurationSeconds}" Width="70" />
                                                <DataGridTextColumn Header="Pkg" Binding="{Binding PackageSeconds}" Width="70" />
                                                <DataGridTextColumn Header="Bonus" Binding="{Binding BonusSeconds}" Width="70" />
                                                <DataGridTextColumn Header="Revenue" Binding="{Binding GameplayRevenue}" Width="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid Grid.Column="1"
                                                  ItemsSource="{Binding CashOperationReportRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  MinHeight="130"
                                                  Margin="0,0,8,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Op" Binding="{Binding OperationId}" Width="70" />
                                                <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="100" />
                                                <DataGridTextColumn Header="Type" Binding="{Binding OperationType}" Width="100" />
                                                <DataGridTextColumn Header="Impact" Binding="{Binding CashImpact}" Width="100" />
                                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid Grid.Column="2"
                                                  ItemsSource="{Binding OperatorActionReportRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  MinHeight="130">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Actor" Binding="{Binding ActorDisplayName}" Width="120" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                                                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90" />
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" />
                                                <DataGridTextColumn Header="Last" Binding="{Binding LastAtUtc}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid DataContext="{Binding Settings}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Settings}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="10">
                            <ListBox ItemsSource="{Binding Panels}"
                                     SelectedItem="{Binding SelectedPanel, Mode=TwoWay}"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#4B5563" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <ScrollViewer Grid.Column="1"
                                      Margin="14,0,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPanel.Label, TargetNullValue=Settings}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="API base URL"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding ApiBaseUrlText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <TextBlock Text="Organization"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <TextBlock Text="Branch"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding BranchIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                </StackPanel>

                                <StackPanel DataContext="{Binding PilotSetup}"
                                            Margin="0,16,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.SelectedPanel.Key, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                             Value="pilot-setup">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Pilot Setup"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       Margin="0,4,0,0"
                                                       Foreground="#047857"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Margin="0,4,0,0"
                                                       Foreground="#B91C1C"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Apply Pilot Setup"
                                                Command="{Binding ApplyCommand}"
                                                MinWidth="130"
                                                Height="32" />
                                    </Grid>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSetupStaff}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Separator Margin="0,14,0,14" />
                                        <TextBlock Text="Staff"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <DataGrid ItemsSource="{Binding StaffUsers}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  MinHeight="112"
                                                  Margin="0,8,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="180" />
                                                <DataGridTextColumn Header="Display" Binding="{Binding DisplayName}" Width="160" />
                                                <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="130" />
                                                <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="140" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSetupLayout}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Separator Margin="0,14,0,14" />
                                        <TextBlock Text="Layout"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Width="160" Margin="0,0,8,8">
                                                <TextBlock Text="Zone" Foreground="#4B5563" />
                                                <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,8">
                                                <TextBlock Text="Seat prefix" Foreground="#4B5563" />
                                                <TextBox Text="{Binding SeatPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="80" Margin="0,0,8,8">
                                                <TextBlock Text="Seats" Foreground="#4B5563" />
                                                <TextBox Text="{Binding SeatCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="100" Margin="0,0,8,8">
                                                <TextBlock Text="Start order" Foreground="#4B5563" />
                                                <TextBox Text="{Binding SeatSortOrderStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSetupTariff}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Tariff"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   Margin="0,14,0,0" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Width="150" Margin="0,0,8,8">
                                                <TextBlock Text="Name" Foreground="#4B5563" />
                                                <TextBox Text="{Binding TariffName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="70" Margin="0,0,8,8">
                                                <TextBlock Text="Currency" Foreground="#4B5563" />
                                                <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,8">
                                                <TextBlock Text="Minor/min" Foreground="#4B5563" />
                                                <TextBox Text="{Binding PricePerMinuteMinorUnits, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,8">
                                                <TextBlock Text="Min mins" Foreground="#4B5563" />
                                                <TextBox Text="{Binding MinimumBillableMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,8">
                                                <TextBlock Text="Round mins" Foreground="#4B5563" />
                                                <TextBox Text="{Binding RoundingIncrementMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,0,8,8">
                                                <TextBlock Text="Effective UTC" Foreground="#4B5563" />
                                                <TextBox Text="{Binding EffectiveFromUtc, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSetupPos}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="POS"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   Margin="0,14,0,0" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Width="140" Margin="0,0,8,8">
                                                <TextBlock Text="Category" Foreground="#4B5563" />
                                                <TextBox Text="{Binding ProductCategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="150" Margin="0,0,8,8">
                                                <TextBlock Text="Product" Foreground="#4B5563" />
                                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="100" Margin="0,0,8,8">
                                                <TextBlock Text="SKU" Foreground="#4B5563" />
                                                <TextBox Text="{Binding ProductSku, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,8">
                                                <TextBlock Text="Price" Foreground="#4B5563" />
                                                <TextBox Text="{Binding ProductPriceMinorUnits, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <CheckBox Content="Track stock"
                                                      IsChecked="{Binding ProductTrackStock}"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="Negative stock"
                                                      IsChecked="{Binding ProductAllowNegativeStock}"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,10,10" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAssignDeviceSeat}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Device Assignment"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   Margin="0,14,0,0" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Width="280" Margin="0,0,8,8">
                                                <TextBlock Text="Device ID" Foreground="#4B5563" />
                                                <TextBox Text="{Binding DeviceIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="0,0,8,8">
                                                <TextBlock Text="Seat" Foreground="#4B5563" />
                                                <TextBox Text="{Binding TargetAssignmentSeatName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <TextBlock Text="Results"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,12,0,0" />
                                    <DataGrid ItemsSource="{Binding Results}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="180"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Step" Binding="{Binding Label}" Width="180" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="210" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <StackPanel DataContext="{Binding TechnicianTools}"
                                            Margin="0,16,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.SelectedPanel.Key, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                             Value="devices">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Technician Devices"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="Device"
                                               Margin="0,10,0,0"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding DeviceIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <Button Content="Refresh Detail"
                                            Command="{Binding RefreshDeviceDetailCommand}"
                                            Height="32" />
                                    <TextBlock Text="{Binding DeviceName}"
                                               Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="{Binding DeviceSeatSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceStateSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceVersionSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceCredentialSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceInstalledAppsSummary}"
                                               Foreground="#4B5563" />

                                    <Separator Margin="0,14,0,14" />

                                    <TextBlock Text="Enrollment"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBox Text="{Binding EnrollmentExpiresInSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Create Enrollment Code"
                                            Command="{Binding CreateEnrollmentCodeCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBlock Text="{Binding EnrollmentCode}"
                                               Margin="0,8,0,0"
                                               Foreground="#047857" />

                                    <Separator Margin="0,14,0,14" />

                                    <TextBlock Text="Command"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBox Text="{Binding CommandType, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <TextBox Text="{Binding CommandReason, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Dispatch"
