<Window x:Class="AFK4.Operator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:AFK4.Operator.App.Shell"
        Title="{Binding Title}"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        Background="#F3F5F7">
    <Grid>
        <Grid Background="#111827">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420"
                    Padding="28"
                    Background="White"
                    BorderBrush="#D8DEE9"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel DataContext="{Binding SignIn}">
                    <TextBlock Text="AFK4 Operator"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Operator sign-in"
                               Margin="0,6,0,22"
                               Foreground="#4B5563" />

                    <TextBlock Text="Organization"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="User"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="Password"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,18" />

                    <Button Content="Sign In"
                            Height="36"
                            Command="{Binding SignInCommand}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,14,0,0"
                               Foreground="#047857"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,8,0,0"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Top"
                    Background="#111827"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentUser.DisplayName, StringFormat=  /  {0}}"
                                   Foreground="#D1D5DB"
                                   Margin="18,3,0,0" />
                        <TextBlock Text="{Binding SelectedWorkspace, StringFormat=Workspace: {0}}"
                                   Foreground="#9CA3AF"
                                   Margin="18,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Sign Out"
                            Command="{Binding SignOutCommand}"
                            MinWidth="92" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Background="#E5E7EB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="0,0,1,0"
                        Padding="10">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Kind}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8"
                                        Padding="10,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Grid.Column="1"
                      Margin="18">
                    <Grid DataContext="{Binding FloorMap}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.FloorMap}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Floor Map"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,14" />

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Seats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FloorMap.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,12,12"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border Width="160"
                                                Height="112"
                                                Background="White"
                                                BorderBrush="#D8DEE9"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827" />
                                                <TextBlock Text="{Binding Zone}"
                                                           Margin="0,6,0,0"
                                                           Foreground="#4B5563" />
                                                <TextBlock Text="{Binding State}"
                                                           Margin="0,12,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="#047857" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid DataContext="{Binding Players}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Players}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,14">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     MinHeight="32" />
                            <Button Content="Search"
                                    Command="{Binding SearchCommand}"
                                    Margin="8,0,0,0"
                                    MinWidth="92" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                                 BorderBrush="#D8DEE9"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   Foreground="#4B5563" />
                                        <TextBlock Text="{Binding BalanceSummary}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#047857" />
                                        <TextBlock Text="{Binding PackageSummary}"
                                                   Foreground="#4B5563" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="14,0,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Player"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding SelectedPlayer.DisplayName, TargetNullValue='No player selected.'}"
                                           Margin="0,8,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding WalletSummaryText}"
                                           Margin="0,4,0,0"
                                           Foreground="#4B5563" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshSelectedPlayerCommand}"
                                        Margin="0,10,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Create player"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBox Text="{Binding NewPlayerDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewPlayerPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Create"
                                        Command="{Binding CreatePlayerCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Wallet"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBox Text="{Binding TopUpAmountMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Top Up"
                                        Command="{Binding TopUpWalletCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />
                                <TextBox Text="{Binding DebtPaymentAmountMinorUnits, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0" />
                                <TextBox Text="{Binding MoneyReason, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Pay Debt"
                                        Command="{Binding PayDebtCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />

                                <Separator Margin="0,14,0,14" />

                                <ItemsControl ItemsSource="{Binding PlayerPackages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827" />
                                                <TextBlock Text="{Binding RemainingSummary}"
                                                           Foreground="#4B5563" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding PendingOperation}"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#B91C1C"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid DataContext="{Binding Settings}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static shell:OperatorWorkspaceKind.Settings}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="White"
                                BorderBrush="#D8DEE9"
                                BorderThickness="1"
                                Padding="10">
                            <ListBox ItemsSource="{Binding Panels}"
                                     SelectedItem="{Binding SelectedPanel, Mode=TwoWay}"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#4B5563" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <ScrollViewer Grid.Column="1"
                                      Margin="14,0,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPanel.Label, TargetNullValue=Settings}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="API base URL"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding ApiBaseUrlText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <TextBlock Text="Organization"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <TextBlock Text="Branch"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding BranchIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                </StackPanel>

                                <StackPanel DataContext="{Binding TechnicianTools}"
                                            Margin="0,16,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.SelectedPanel.Key, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                             Value="devices">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Technician Devices"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="Device"
                                               Margin="0,10,0,0"
                                               Foreground="#4B5563" />
                                    <TextBox Text="{Binding DeviceIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,8" />
                                    <Button Content="Refresh Detail"
                                            Command="{Binding RefreshDeviceDetailCommand}"
                                            Height="32" />
                                    <TextBlock Text="{Binding DeviceName}"
                                               Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="{Binding DeviceSeatSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceStateSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceVersionSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceCredentialSummary}"
                                               Foreground="#4B5563" />
                                    <TextBlock Text="{Binding DeviceInstalledAppsSummary}"
                                               Foreground="#4B5563" />

                                    <Separator Margin="0,14,0,14" />

                                    <TextBlock Text="Enrollment"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBox Text="{Binding EnrollmentExpiresInSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Create Enrollment Code"
                                            Command="{Binding CreateEnrollmentCodeCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBlock Text="{Binding EnrollmentCode}"
                                               Margin="0,8,0,0"
                                               Foreground="#047857" />

                                    <Separator Margin="0,14,0,14" />

                                    <TextBlock Text="Command"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBox Text="{Binding CommandType, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <TextBox Text="{Binding CommandReason, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Dispatch"
                                            Command="{Binding DispatchDeviceCommandCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBox Text="{Binding CommandIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Refresh Command Status"
                                            Command="{Binding RefreshCommandStatusCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBlock Text="{Binding CommandStatus}"
                                               Margin="0,8,0,0"
                                               Foreground="#4B5563" />

                                    <Separator Margin="0,14,0,14" />

                                    <TextBlock Text="Credential"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <Button Content="Rotate"
                                            Command="{Binding RotateCredentialCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBox Text="{Binding CredentialIdText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <TextBox Text="{Binding RotatedCredentialSecret, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0" />
                                    <Button Content="Revoke"
                                            Command="{Binding RevokeCredentialCommand}"
                                            Margin="0,8,0,0"
                                            Height="32" />
                                    <TextBlock Text="{Binding CredentialStatus}"
                                               Margin="0,8,0,0"
                                               Foreground="#4B5563" />

                                    <TextBlock Text="{Binding StatusMessage}"
                                               Margin="0,14,0,0"
                                               Foreground="#047857"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Margin="0,8,0,0"
                                               Foreground="#B91C1C"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#D8DEE9"
                        BorderThickness="1,0,0,0"
                        Padding="16"
                        DataContext="{Binding FloorMap.SeatContext}">
                    <StackPanel>
                        <TextBlock Text="Context"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="{Binding SelectedSeat.Name, TargetNullValue='No seat selected.'}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="{Binding SelectedSeat.State}"
                                   Margin="0,4,0,0"
                                   Foreground="#4B5563" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <TextBlock Text="Remaining: "
                                       Foreground="#4B5563" />
                            <TextBlock Text="{Binding SelectedSeat.RemainingSeconds, TargetNullValue=-}"
                                       Foreground="#4B5563" />
                            <TextBlock Text="s"
                                       Foreground="#4B5563" />
                        </StackPanel>
                        <Separator Margin="0,16,0,16" />

                        <TextBlock Text="Start guest"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Duration"
                                   Margin="0,8,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <TextBlock Text="Billing mode"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding BillingMode, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Start"
                                Command="{Binding StartGuestSessionCommand}"
                                Height="32" />

                        <Separator Margin="0,16,0,16" />

                        <TextBlock Text="Active session"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Additional minutes"
                                   Margin="0,8,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding AdditionalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Extend"
                                Command="{Binding ExtendSessionCommand}"
                                Height="32" />
                        <TextBlock Text="Target seat id"
                                   Margin="0,12,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding TargetSeatIdText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Transfer"
                                Command="{Binding TransferSessionCommand}"
                                Height="32" />
                        <TextBlock Text="Reason"
                                   Margin="0,12,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="End"
                                Command="{Binding EndSessionCommand}"
                                Height="32" />

                        <Separator Margin="0,16,0,16" />
                        <TextBlock Text="{Binding PendingOperation}"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,8,0,0"
                                   Foreground="#047857"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="0,8,0,0"
                                   Foreground="#B91C1C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
