                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#D8DEE9"
                        BorderThickness="1,0,0,0"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Context"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />

                            <StackPanel DataContext="{Binding FloorMap.SeatContext}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shell:OperatorWorkspaceKind.FloorMap}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#F9FAFB"
                                        BorderBrush="#D8DEE9"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedSeatSummary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedSeat.Zone}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#4B5563" />
                                        <TextBlock Text="{Binding SelectedSeat.RemainingSeconds, StringFormat=Remaining {0}s}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#4B5563" />
                                    </StackPanel>
                                </Border>
                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Start Guest Session"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Duration, minutes"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563" />
                                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0" />
                                <TextBlock Text="Billing"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563" />
                                <ComboBox ItemsSource="{Binding BillingModeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding BillingMode, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,4,0,0" />
                                <TextBlock Text="Fast smoke start; no player account or ledger entry."
                                           Margin="0,4,0,0"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayerBillingRequired}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Player account ID"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayerBillingRequired}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding PlayerAccountIdText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayerBillingRequired}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="Tariff version ID"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayerBillingRequired}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding TariffVersionIdText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayerBillingRequired}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Content="Start Guest Session"
                                        Command="{Binding StartGuestSessionCommand}"
                                        Margin="0,8,0,0"
                                        Height="34" />

                                <Separator Margin="0,14,0,14" />

                                <TextBlock Text="Active session"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBox Text="{Binding AdditionalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0" />
                                <Button Content="Extend"
                                        Command="{Binding ExtendSessionCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />
                                <TextBox Text="{Binding TargetSeatIdText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0" />
                                <Button Content="Transfer"
                                        Command="{Binding TransferSessionCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />
                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0" />
                                <Button Content="End"
                                        Command="{Binding EndSessionCommand}"
                                        Margin="0,8,0,0"
                                        Height="32" />

                                <TextBlock Text="{Binding PendingOperation}"
                                           Margin="0,14,0,0"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#B91C1C"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Players}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shell:OperatorWorkspaceKind.Players}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedPlayer.DisplayName, TargetNullValue='No player selected.'}"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding WalletSummaryText}"
                                           Margin="0,6,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding PendingOperation}"
                                           Margin="0,14,0,0"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Pos}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shell:OperatorWorkspaceKind.Pos}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CartSummary}"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding LastSaleId, StringFormat=Sale {0}, TargetNullValue='No sale yet.'}"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastSaleState, StringFormat=State {0}}"
                                           Margin="0,4,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding LastReceipt.ReceiptNumber, StringFormat=Receipt {0}}"
                                           Margin="0,4,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding PendingOperation}"
                                           Margin="0,14,0,0"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Shifts}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shell:OperatorWorkspaceKind.Shifts}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CurrentShiftState, TargetNullValue='No open shift'}"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding CurrentShiftId, StringFormat=Shift {0}}"
                                           Margin="0,8,0,0"
                                           Foreground="#4B5563"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExpectedCashMinorUnits, StringFormat=Expected {0}}"
                                           Margin="0,6,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding DifferenceMinorUnits, StringFormat=Difference {0}}"
                                           Margin="0,4,0,0"
                                           Foreground="#4B5563" />
                                <TextBlock Text="{Binding PendingOperation}"
                                           Margin="0,14,0,0"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="#047857"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Settings}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shell:OperatorWorkspaceKind.Settings}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedPanel.Label, TargetNullValue=Settings}"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{Binding SelectedPanel.Description}"
                                           Margin="0,6,0,0"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
