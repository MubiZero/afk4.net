<Window x:Class="AFK4.Operator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        Background="#F3F5F7">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="18,12">
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Seats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="112" Margin="0,0,12,12" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                                <TextBlock Text="{Binding Zone}" Margin="0,6,0,0" Foreground="#4B5563" />
                                <TextBlock Text="{Binding State}" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="#047857" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="1" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding TechnicianWorkflow}">
                    <StackPanel>
                        <TextBlock Text="Technician" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />

                        <TextBlock Text="Organization" Margin="0,14,0,4" Foreground="#4B5563" />
                        <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Branch" Margin="0,10,0,4" Foreground="#4B5563" />
                        <TextBox Text="{Binding BranchIdText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Device" Margin="0,10,0,4" Foreground="#4B5563" />
                        <TextBox Text="{Binding DeviceIdText, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator Margin="0,14,0,12" />

                        <TextBlock Text="Enrollment" FontWeight="SemiBold" Foreground="#111827" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EnrollmentExpiresInSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Create" Margin="8,0,0,0" Command="{Binding CreateEnrollmentCodeCommand}" />
                        </Grid>
                        <TextBox Text="{Binding EnrollmentCode}" Margin="0,8,0,0" IsReadOnly="True" />
                        <TextBlock Text="{Binding EnrollmentCodeExpiresAtUtc}" Margin="0,4,0,0" Foreground="#4B5563" />

                        <Separator Margin="0,14,0,12" />

                        <TextBlock Text="Command" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBox Text="{Binding CommandType, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding CommandReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <Button Content="Dispatch" Margin="0,8,0,0" Command="{Binding DispatchDeviceCommandCommand}" />
                        <TextBox Text="{Binding CommandIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CommandStatus}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#111827" />
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommandStatusCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding CommandStatusMessage}" Margin="0,4,0,0" Foreground="#4B5563" TextWrapping="Wrap" />

                        <Separator Margin="0,14,0,12" />

                        <TextBlock Text="Credential" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBox Text="{Binding CredentialIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Rotate" Command="{Binding RotateCredentialCommand}" />
                            <Button Grid.Column="1" Content="Revoke" Margin="8,0,0,0" Command="{Binding RevokeCredentialCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding CredentialStatus}" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBox Text="{Binding RotatedCredentialSecret}" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0" Foreground="#047857" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" Foreground="#B91C1C" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
