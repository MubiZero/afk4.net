<Window x:Class="AFK4.Operator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        Background="#F3F5F7">
    <Grid>
        <Grid Background="#111827">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420"
                    Padding="28"
                    Background="White"
                    BorderBrush="#D8DEE9"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel DataContext="{Binding SignIn}">
                    <TextBlock Text="AFK4 Operator"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Operator sign-in"
                               Margin="0,6,0,22"
                               Foreground="#4B5563" />

                    <TextBlock Text="Organization"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding OrganizationIdText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="User"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12" />

                    <TextBlock Text="Password"
                               Foreground="#4B5563" />
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,18" />

                    <Button Content="Sign In"
                            Height="36"
                            Command="{Binding SignInCommand}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,14,0,0"
                               Foreground="#047857"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,8,0,0"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Top"
                    Background="#111827"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentUser.DisplayName, StringFormat=  /  {0}}"
                                   Foreground="#D1D5DB"
                                   Margin="18,3,0,0" />
                        <TextBlock Text="{Binding SelectedWorkspace, StringFormat=Workspace: {0}}"
                                   Foreground="#9CA3AF"
                                   Margin="18,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Sign Out"
                            Command="{Binding SignOutCommand}"
                            MinWidth="92" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Background="#E5E7EB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="0,0,1,0"
                        Padding="10">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Kind}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8"
                                        Padding="10,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Grid.Column="1"
                      Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Floor Map"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,14" />

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding FloorMap.Seats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.FloorMap.SelectSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,12,12"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Border Width="160"
                                            Height="112"
                                            Background="White"
                                            BorderBrush="#D8DEE9"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock Text="{Binding Zone}"
                                                       Margin="0,6,0,0"
                                                       Foreground="#4B5563" />
                                            <TextBlock Text="{Binding State}"
                                                       Margin="0,12,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="#047857" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#D8DEE9"
                        BorderThickness="1,0,0,0"
                        Padding="16"
                        DataContext="{Binding FloorMap.SeatContext}">
                    <StackPanel>
                        <TextBlock Text="Context"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="{Binding SelectedSeat.Name, TargetNullValue='No seat selected.'}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="{Binding SelectedSeat.State}"
                                   Margin="0,4,0,0"
                                   Foreground="#4B5563" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <TextBlock Text="Remaining: "
                                       Foreground="#4B5563" />
                            <TextBlock Text="{Binding SelectedSeat.RemainingSeconds, TargetNullValue=-}"
                                       Foreground="#4B5563" />
                            <TextBlock Text="s"
                                       Foreground="#4B5563" />
                        </StackPanel>
                        <Separator Margin="0,16,0,16" />

                        <TextBlock Text="Start guest"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Duration"
                                   Margin="0,8,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <TextBlock Text="Billing mode"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding BillingMode, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Start"
                                Command="{Binding StartGuestSessionCommand}"
                                Height="32" />

                        <Separator Margin="0,16,0,16" />

                        <TextBlock Text="Active session"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Additional minutes"
                                   Margin="0,8,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding AdditionalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Extend"
                                Command="{Binding ExtendSessionCommand}"
                                Height="32" />
                        <TextBlock Text="Target seat id"
                                   Margin="0,12,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding TargetSeatIdText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="Transfer"
                                Command="{Binding TransferSessionCommand}"
                                Height="32" />
                        <TextBlock Text="Reason"
                                   Margin="0,12,0,0"
                                   Foreground="#4B5563" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,8" />
                        <Button Content="End"
                                Command="{Binding EndSessionCommand}"
                                Height="32" />

                        <Separator Margin="0,16,0,16" />
                        <TextBlock Text="{Binding PendingOperation}"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,8,0,0"
                                   Foreground="#047857"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="0,8,0,0"
                                   Foreground="#B91C1C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
