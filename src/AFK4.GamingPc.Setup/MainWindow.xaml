<Window x:Class="AFK4.GamingPc.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK4 Gaming PC Setup"
        Width="560"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AFK4 Gaming PC Setup" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EnvironmentLabel}" Margin="0,6,0,0" Foreground="#555555" />
            <TextBlock Text="{Binding MachineLabel}" Margin="0,2,0,0" Foreground="#555555" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="32" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,10,0,0" />
            <PasswordBox Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0" PasswordChanged="PasswordBox_OnPasswordChanged" />
        </Grid>

        <Button Grid.Row="2"
                Content="Install And Enroll"
                Command="{Binding InstallCommand}"
                Height="38"
                Width="180"
                HorizontalAlignment="Left" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Steps}" Margin="0,18,0,18">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Message}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Foreground="#666666" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="{Binding FinalStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Grid>
</Window>
