<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AFK4.Shared.Contracts\AFK4.Shared.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Сборка проверяется анализатором Native AOT: отражение в JSON и вообще любое, которое AOT не переживёт,
       ломает сборку. Нужно для net10.0; JSON — сгенерированный (SetupWizardJson.cs). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The client build injects the channel's platform origin (scripts/build-client-packages.ps1
       passes -p:AFK4PlatformBaseUrl). SetupWizardDefaults reads this attribute at runtime; when
       the property is unset (dev/test builds) no attribute is emitted and the code falls back to
       staging. -->
  <ItemGroup Condition="'$(AFK4PlatformBaseUrl)' != ''">
    <AssemblyMetadata Include="AFK4.PlatformBaseUrl" Value="$(AFK4PlatformBaseUrl)" />
  </ItemGroup>

</Project>
