# Copy these names into Coolify application environment variables.
# Do not commit secrets or a filled copy of this template.
# In Coolify, mark these variables as runtime-only. Do not expose secrets as
# build-time variables.

ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
AllowedHosts=<coolify-staging-domain>;localhost;127.0.0.1

# Values returned by /api/install/enroll and written into Agent machine env.
Install__ApiBaseUrl=https://<coolify-staging-domain>
Install__UpdateChannel=internal
Install__UpdatePackageSigningPublicKeyPem=<coolify-staging-update-package-signing-public-key-pem>

# Browser SPA origins allowed to call the Platform API. Keep these runtime-only.
Cors__PlatformWebOrigins__0=https://platform.afk4.staging.mubi.dev

# Preferred source: Coolify-managed PostgreSQL service connection details.
# Keep the password in Coolify secrets.
ConnectionStrings__PlatformDatabase=Host=<coolify-managed-postgres-host>;Port=5432;Database=<coolify-managed-postgres-database>;Username=<coolify-managed-postgres-user>;Password=<coolify-managed-postgres-password>;SSL Mode=Disable;GSS Encryption Mode=Disable

# ECDSA P-256 private key used by Platform API to sign session leases.
# Store the PEM value as a Coolify secret with preserved newlines.
Sessions__SigningPrivateKeyPem=<coolify-secret-session-lease-private-key-pem>

# Base URL of Organization Admin in this environment. The API builds the
# support-mode sign-in link from this value. Empty (the appsettings.json
# default) makes the link relative and opens inside Platform Control instead
# of Organization Admin, so support sign-in silently fails. See
# docs/runbooks/support-mode.md.
SupportAccess__OrganizationAdminBaseUrl=<organization-admin-base-url>

# Multi-tenant dcgate payments (Subsystem A). Required for online top-up routing.
# Base URL of the dcgate gateway the Platform API calls outbound.
DcGate__BaseUrl=https://dcgate.mubi.dev
# 32-byte AES key (base64) that encrypts per-branch dcgate credentials at rest.
# Generate once per environment and NEVER rotate without re-encrypting stored rows.
# Keep as a Coolify secret, runtime-only. Generate: openssl rand -base64 32
Secrets__EncryptionKeyBase64=<coolify-secret-32-byte-base64-aes-key>

# Owner cabinet onboarding (Subsystem B). Lets a club owner provision their own
# dcgate project (card) and attach its receiving Telegram account from the cabinet.
# dcgate ADMIN_JWT_SECRET — server-side only; the owner never sees it. Coolify secret.
DcGate__AdminSecret=<coolify-secret-dcgate-admin-jwt-secret>
# Full public webhook URL stamped into newly provisioned dcgate projects.
DcGate__WebhookUrl=https://afk4.staging.mubi.dev/api/public/payments/dcgate/webhook
# Payment-link expiry (minutes) for provisioned projects.
DcGate__PaymentExpiresInMinutes=30

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
