# Copy these names into Coolify application environment variables.
# Do not commit secrets or a filled copy of this template.

ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
AllowedHosts=<coolify-staging-domain>
AFK4_STAGING_PUBLIC_BASE_URL=https://<coolify-staging-domain>

# Preferred source: Coolify-managed PostgreSQL service connection details.
# Keep the password in Coolify secrets.
ConnectionStrings__PlatformDatabase=Host=<coolify-managed-postgres-host>;Port=5432;Database=<coolify-managed-postgres-database>;Username=<coolify-managed-postgres-user>;Password=<coolify-managed-postgres-password>;GSS Encryption Mode=Disable

# ECDSA P-256 private key used by Platform API to sign session leases.
# Store the PEM value as a Coolify secret with preserved newlines.
Sessions__SigningPrivateKeyPem=<coolify-secret-session-lease-private-key-pem>

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
