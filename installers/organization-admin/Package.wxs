<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Имя, которое видит человек, — «Панель AFK4.NET» (решение владельца 2026-09-23): так же
       программу называют мастер и панель. Кириллице нужна кодовая страница 1251 — по умолчанию
       WiX берёт 1252, и кириллица в ней не представима. Папка установки остаётся
       «Organization Admin»: по этому пути программу находят агент и мастер. -->
  <Package
      Name="Панель AFK4.NET"
      Manufacturer="AFK4.NET"
      Codepage="1251"
      Version="$(var.PackageVersion)"
      UpgradeCode="{5B345D78-17AE-4CC7-9FE7-7E5F4203FAF1}"
      Scope="perMachine">
    <SummaryInformation Codepage="1251" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Уже установлена более новая версия Панели AFK4.NET." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AFK4RootFolder" Name="AFK4">
        <Directory Id="OrganizationAdminFolder" Name="Organization Admin" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OrganizationAdminMenuFolder" Name="AFK4.NET" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Панель AFK4.NET" Level="1">
      <ComponentGroupRef Id="OrganizationAdminFiles" />
      <ComponentRef Id="OrganizationAdminAgentConfiguration" />
      <ComponentRef Id="OrganizationAdminStartMenuShortcut" />
      <ComponentRef Id="OrganizationAdminDesktopShortcut" />
      <ComponentRef Id="OrganizationAdminAutoStart" />
    </Feature>

    <!-- Автозапуск при входе в Windows. Касса — первое, что нужно после включения ПК, а после
         отключения света кассир искал ярлык (увидено на приёмке в VM 26.10.2026). Второй экземпляр
         Панель не открывает: повторный запуск выводит уже открытую вперёд. MSI Панели ставится
         только на ПК администратора, игровым ПК эта запись не достаётся. -->
    <Component Id="OrganizationAdminAutoStart" Directory="OrganizationAdminFolder" Guid="{0E3B7C52-6A41-4F0D-9B7E-2C8D5A41F3B6}">
      <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="AFK4.NET Panel"
          Type="string"
          Value="&quot;[OrganizationAdminFolder]AFK4.OrganizationAdmin.App.exe&quot;"
          KeyPath="yes" />
    </Component>

    <!-- Start Menu shortcut so the cashier can launch the operator after the wizard installs it. -->
    <Component Id="OrganizationAdminStartMenuShortcut" Directory="OrganizationAdminMenuFolder" Guid="{5686D743-A622-4B89-8983-29B596BBCBC6}">
      <Shortcut
          Id="OrganizationAdminShortcut"
          Name="Панель AFK4.NET"
          Description="Карта зала, касса и настройки клуба"
          Target="[OrganizationAdminFolder]AFK4.OrganizationAdmin.App.exe"
          WorkingDirectory="OrganizationAdminFolder" />
      <RemoveFolder Id="RemoveOrganizationAdminMenuFolder" Directory="OrganizationAdminMenuFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\AFK4\OrganizationAdmin"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut: the operator is a daily-use cashier tool, so a desktop icon is expected. -->
    <Component Id="OrganizationAdminDesktopShortcut" Directory="DesktopFolder" Guid="{5D1BFA85-EE72-4427-AEF9-133EEDB21FB6}">
      <Shortcut
          Id="OrganizationAdminDesktopShortcutLink"
          Name="Панель AFK4.NET"
          Description="Карта зала, касса и настройки клуба"
          Target="[OrganizationAdminFolder]AFK4.OrganizationAdmin.App.exe"
          WorkingDirectory="OrganizationAdminFolder" />
      <RegistryValue
          Root="HKLM"
          Key="Software\AFK4\OrganizationAdmin"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <ComponentGroup Id="OrganizationAdminFiles" Directory="OrganizationAdminFolder">
      <Files Include="$(var.OrganizationAdminPublishDir)\**" />
    </ComponentGroup>

    <Component Id="OrganizationAdminAgentConfiguration" Directory="OrganizationAdminFolder" Guid="{17688042-51F4-47C6-894C-E70A2CC2611F}">
      <RegistryValue
          Root="HKLM"
          Key="Software\AFK4\OrganizationAdmin"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <Environment
          Id="OrganizationAdminVersionEnvironment"
          Name="Agent__OrganizationAdminVersion"
          Value="$(var.PackageVersion)"
          Action="set"
          Part="all"
          System="yes" />
      <Environment
          Id="OrganizationAdminExecutablePathEnvironment"
          Name="Agent__OrganizationAdminExecutablePath"
          Value="[OrganizationAdminFolder]AFK4.OrganizationAdmin.App.exe"
          Action="set"
          Part="all"
          System="yes" />
    </Component>
  </Package>
</Wix>
