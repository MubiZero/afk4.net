<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="AFK4.NET Player Shell"
      Manufacturer="AFK4.NET"
      Version="$(var.PackageVersion)"
      UpgradeCode="{A234E9ED-8992-4852-9A27-C39D1F46D35A}"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AFK4.NET Player Shell is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The shell host renders its UI in the Microsoft Edge WebView2 Evergreen Runtime, so the
         runtime is a hard prerequisite. EdgeUpdate records the per-machine runtime version (pv)
         under the 64-bit client key, which lives in WOW6432Node on 64-bit Windows (read via the
         32-bit registry view). Block a fresh install with a clear message when it is absent;
         "Installed" keeps uninstall/repair working. Managed gaming-PC fleets pre-provision the
         runtime; a future Burn bundle could chain the Evergreen bootstrapper to auto-install it. -->
    <Property Id="WEBVIEW2RUNTIME">
      <RegistrySearch
          Id="WebView2RuntimePv"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw"
          Bitness="always32" />
    </Property>
    <Launch
        Condition="Installed OR WEBVIEW2RUNTIME"
        Message="Microsoft Edge WebView2 Runtime is required. Install the Evergreen WebView2 Runtime and run this installer again." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AFK4RootFolder" Name="AFK4">
        <Directory Id="PlayerShellFolder" Name="Player Shell" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AFK4.NET Player Shell" Level="1">
      <ComponentGroupRef Id="PlayerShellFiles" />
      <ComponentRef Id="PlayerShellAgentConfiguration" />
    </Feature>

    <ComponentGroup Id="PlayerShellFiles" Directory="PlayerShellFolder">
      <Files Include="$(var.PlayerShellPublishDir)\**" />
    </ComponentGroup>

    <Component Id="PlayerShellAgentConfiguration" Directory="PlayerShellFolder" Guid="{38511F7D-8B7A-45F4-B97D-7FA6E850918E}">
      <RegistryValue
          Root="HKLM"
          Key="Software\AFK4\PlayerShell"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <Environment
          Id="ShellVersionEnvironment"
          Name="Agent__ShellVersion"
          Value="$(var.PackageVersion)"
          Action="set"
          Part="all"
          System="yes" />
      <Environment
          Id="PlayerShellExecutablePathEnvironment"
          Name="Agent__PlayerShellExecutablePath"
          Value="[PlayerShellFolder]AFK4.Player.Shell.exe"
          Action="set"
          Part="all"
          System="yes" />
      <Environment
          Id="PlayerShellAutoStartEnvironment"
          Name="Agent__PlayerShellAutoStartEnabled"
          Value="true"
          Action="set"
          Part="all"
          System="yes" />
    </Component>
  </Package>
</Wix>
