<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="AFK4.NET Player Shell"
      Manufacturer="AFK4.NET"
      Version="$(var.PackageVersion)"
      UpgradeCode="{A234E9ED-8992-4852-9A27-C39D1F46D35A}"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AFK4.NET Player Shell is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- EdgeUpdate records the runtime version (pv) in three places: the 64-bit client key read
         through the 32-bit view (WOW6432Node) for the usual per-machine install, the plain 64-bit
         key, and HKCU for a per-user install. "0.0.0.0" means the key outlived the runtime. All
         three are checked here, in the Burn bundle and in the update helper — one answer to
         "is WebView2 here?" everywhere. "Installed" keeps uninstall/repair working. -->
    <Property Id="WEBVIEW2_RUNTIME_HKLM_PV">
      <RegistrySearch
          Id="WebView2RuntimeHklmPv"
          Root="HKLM"
          Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw" />
    </Property>
    <Property Id="WEBVIEW2_RUNTIME_HKLM64_PV">
      <RegistrySearch
          Id="WebView2RuntimeHklm64Pv"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw" />
    </Property>
    <Property Id="WEBVIEW2_RUNTIME_HKCU_PV">
      <RegistrySearch
          Id="WebView2RuntimeHkcuPv"
          Root="HKCU"
          Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw" />
    </Property>
    <Launch
        Condition="Installed OR (WEBVIEW2_RUNTIME_HKLM_PV AND WEBVIEW2_RUNTIME_HKLM_PV &lt;&gt; &quot;0.0.0.0&quot;) OR (WEBVIEW2_RUNTIME_HKLM64_PV AND WEBVIEW2_RUNTIME_HKLM64_PV &lt;&gt; &quot;0.0.0.0&quot;) OR (WEBVIEW2_RUNTIME_HKCU_PV AND WEBVIEW2_RUNTIME_HKCU_PV &lt;&gt; &quot;0.0.0.0&quot;)"
        Message="Microsoft Edge WebView2 Runtime is required and was not found. Install AFK4 with afk4-client-&lt;version&gt;-&lt;channel&gt;.exe — it installs the runtime for you. To install this MSI on its own, get the runtime from https://go.microsoft.com/fwlink/p/?LinkId=2124703 first." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AFK4RootFolder" Name="AFK4">
        <Directory Id="PlayerShellFolder" Name="Player Shell" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AFK4.NET Player Shell" Level="1">
      <ComponentGroupRef Id="PlayerShellFiles" />
      <ComponentRef Id="PlayerShellAgentConfiguration" />
    </Feature>

    <ComponentGroup Id="PlayerShellFiles" Directory="PlayerShellFolder">
      <Files Include="$(var.PlayerShellPublishDir)\**" />
    </ComponentGroup>

    <Component Id="PlayerShellAgentConfiguration" Directory="PlayerShellFolder" Guid="{38511F7D-8B7A-45F4-B97D-7FA6E850918E}">
      <RegistryValue
          Root="HKLM"
          Key="Software\AFK4\PlayerShell"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <Environment
          Id="ShellVersionEnvironment"
          Name="Agent__ShellVersion"
          Value="$(var.PackageVersion)"
          Action="set"
          Part="all"
          System="yes" />
      <Environment
          Id="PlayerShellExecutablePathEnvironment"
          Name="Agent__PlayerShellExecutablePath"
          Value="[PlayerShellFolder]AFK4.Player.Shell.exe"
          Action="set"
          Part="all"
          System="yes" />
      <Environment
          Id="PlayerShellAutoStartEnvironment"
          Name="Agent__PlayerShellAutoStartEnabled"
          Value="true"
          Action="set"
          Part="all"
          System="yes" />
    </Component>
  </Package>
</Wix>
