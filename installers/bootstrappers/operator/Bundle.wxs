<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <!--
    Master installer (Burn bundle) for the AFK4.NET Operator workstation.
    Ensures the .NET 10 Desktop Runtime (x64) is present (downloaded from Microsoft
    if missing) and then installs the Operator App MSI.

    Runtime prerequisite (version/url/hash/size) is pinned in the shared
    RuntimePrereq.wxi so it stays in sync with the Gaming PC bundle. The hash is the
    SHA-512 of the payload (Burn verifies downloads with SHA-512).
  -->
  <?include ..\RuntimePrereq.wxi ?>

  <Bundle
      Name="AFK4.NET Operator"
      Manufacturer="AFK4.NET"
      Version="$(var.PackageVersion)"
      UpgradeCode="{3F7B1D6C-9A24-4E58-B0D3-6C9E2A4F8B12}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <netfx:DotNetCoreSearch
        Id="DesktopRuntime10"
        RuntimeType="desktop"
        Platform="x64"
        MajorVersion="10"
        Variable="DesktopRuntime10Version" />

    <Chain>
      <ExePackage
          DetectCondition="DesktopRuntime10Version AND DesktopRuntime10Version &gt;= v$(var.RuntimeVersion)"
          Permanent="yes"
          Vital="yes"
          PerMachine="yes"
          InstallArguments="/install /quiet /norestart"
          RepairArguments="/repair /quiet /norestart"
          UninstallArguments="/uninstall /quiet /norestart"
          bal:PrereqPackage="yes">
        <ExePackagePayload
            Name="windowsdesktop-runtime-$(var.RuntimeVersion)-win-x64.exe"
            DownloadUrl="$(var.RuntimeUrl)"
            ProductName=".NET Desktop Runtime $(var.RuntimeVersion) (x64)"
            Description=".NET Desktop Runtime $(var.RuntimeVersion) (x64)"
            Hash="$(var.RuntimeHash)"
            Size="$(var.RuntimeSize)" />
      </ExePackage>

      <MsiPackage SourceFile="$(var.OperatorMsiPath)" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
