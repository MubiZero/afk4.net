<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared .NET 10 Desktop Runtime (x64) prerequisite definitions for the AFK4.NET
  master installers (Burn bundles). Single source of truth: both the Gaming PC and
  Operator Bundle.wxs <?include?> this file, so the pinned version/url/hash/size live
  in ONE place. Bump RuntimeVersion/Url/Hash/Size together when moving to a newer
  .NET 10 servicing release.

  RuntimeHash is the SHA-512 of the downloaded payload, UPPERCASE hex (128 chars).
  Burn verifies downloaded ExePackagePayload bytes with SHA-512 at install time, so a
  SHA-256 here would make every install on a machine without .NET 10 fail runtime
  verification. Compute via:
    (Get-FileHash -Algorithm SHA512 -LiteralPath <runtime.exe>).Hash
-->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define RuntimeVersion = "10.0.9" ?>
  <?define RuntimeUrl = "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.9/windowsdesktop-runtime-10.0.9-win-x64.exe" ?>
  <?define RuntimeHash = "99BC2215D67F8AEA1ECB3DF642423CCABF76E5261B225F0F2D78123D84D58E64923F050A5DC58405C4D5CF074ACBAD32C4A1021A67E94629DCC57206AC4116DE" ?>
  <?define RuntimeSize = "59878128" ?>
</Include>
