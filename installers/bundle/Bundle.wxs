<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    AFK4.NET client master installer (Burn bundle), one per channel:
    afk4-client-<version>-<channel>.exe.

    The installer carries everything a club PC needs: nothing is downloaded and nobody is told to
    go and install something (decision of 2026-10-01).

    .NET: every program (agent service, setup wizard, player shell, Organization Admin) is
    published self-contained for win-x64, so the runtime lives in each program's own folder.
    The bundle chains no .NET prerequisite at all.

    Windows 7 to 11, x86 and x64 (docs/roadmap/windows7.md): the programs are Native AOT, one file of machine
    code each, and every window a human sees is Win32 + Miniblink (AFK4.WebHost, one DLL beside the exe). No browser runtime,
    no 210 MB offline installer in the bundle.

    VC++ Redistributable is deliberately not chained: the programs ship no managed runtime and the
    BAFunctions DLL is linked with /MT.
  -->
  <Bundle
      Name="AFK4.NET"
      Manufacturer="AFK4.NET"
      Version="$(var.PackageVersion)"
      Compressed="yes"
      IconSourceFile="$(var.BrandIconPath)"
      UpgradeCode="{8E2C4A91-7B3D-4F6A-9C1E-2D5A8B0F3471}">

    <!--
      Язык окна. Аудитория — клубы Таджикистана, и окно говорит по-русски у всех: BundleUi.ru.wxl
      едет как thm.wxl — язык по умолчанию. WixStdBA сам подбирает языковую папку рядом с
      thm.wxl по предпочитаемым языкам Windows (десятичный LCID), поэтому таджикский
      BundleUi.tg.wxl лежит в 1064\thm.wxl; принудительно — `afk4-client.exe /lang 1064`. Это
      не файл для -loc: Id этих .wxl читает само окно во время работы, а не компилятор.
    -->
    <!--
      LogoFile brands the bootstrapper window with the AFK4 mark. The AFK4.BAFunctions
      payload (bal:BAFunctions) plugs into WixStdBA to auto-start the install and
      auto-close on success, so the only prompt the user sees is Windows' UAC. It's a
      tiny native, statically-linked DLL (no .NET/VC++ runtime needed) — see
      installers/bundle/bafunctions/.
    -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" SuppressOptionsUI="yes" LogoFile="$(var.BrandLogoPath)" LocalizationFile="$(sys.SOURCEFILEDIR)BundleUi.ru.wxl" />
      <Payload Id="AfkBAFunctions" SourceFile="$(var.BAFunctionsPath)" bal:BAFunctions="yes" />
      <Payload Id="AfkBundleUiTajik" Name="1064\thm.wxl" SourceFile="$(sys.SOURCEFILEDIR)BundleUi.tg.wxl" />
    </BootstrapperApplication>

    <!--
      Тихая установка по коду: `afk4-client.exe /quiet AFK4_INSTALL_CODE=… [AFK4_SEAT=…]`. Burn
      пускает с командной строки только переменные, помеченные Overridable; код Hidden — его
      значения нет в журнале установщика. Дальше обе едут в MSI агента одноимёнными свойствами.
    -->
    <Variable Name="AFK4_INSTALL_CODE" bal:Overridable="yes" Hidden="yes" Value="" />
    <Variable Name="AFK4_SEAT" bal:Overridable="yes" Value="" />

    <Chain>
      <!--
        Файлы установки ролей (MSI Player Shell и Organization Admin) — до MSI агента: тот в конце
        запускает мастер, а мастер ищет их в …\Setup Wizard\payload\. Они не внутри MSI агента, чтобы
        обновления агента не возили лишние ~110 МБ: нужны они только при первой установке.
      -->
      <MsiPackage SourceFile="$(var.SetupPayloadMsiPath)" DisplayName="AFK4.NET Setup Payload" Vital="yes" />

      <!-- LAUNCHWIZARD=1 makes the agent MSI auto-launch the Setup Wizard even though Burn
           runs it at UILevel=none; see the LaunchSetupWizard condition in installers/agent/Package.wxs. -->
      <MsiPackage SourceFile="$(var.AgentMsiPath)" DisplayName="AFK4.NET" Vital="yes">
        <MsiProperty Name="LAUNCHWIZARD" Value="1" />
        <MsiProperty Name="AFK4_INSTALL_CODE" Value="[AFK4_INSTALL_CODE]" />
        <MsiProperty Name="AFK4_SEAT" Value="[AFK4_SEAT]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
