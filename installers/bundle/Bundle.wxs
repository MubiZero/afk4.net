<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    AFK4.NET client master installer (Burn bundle), one per channel:
    afk4-client-<version>-<channel>.exe.

    Chains the .NET 10 Desktop Runtime (x64) CARRIED INSIDE the bundle (Compressed="yes",
    SourceFile, NO DownloadUrl) as a vital prerequisite, then the agent MSI. Carrying the
    runtime — rather than downloading it — is the deliberate difference from the reverted
    download bundle (commit 20a7a31): the runtime is extracted and installed synchronously
    before the MSI runs, so a freshly-imaged machine never starts the framework-dependent
    agent service against a missing/unregistered runtime (the old sc-1053 failure).

    The pinned runtime version/URL/SHA-512 live in scripts/build-client-packages.ps1, which
    downloads + verifies the runtime at build time and passes its path via RuntimeInstallerPath.

    Second prerequisite: the Microsoft Edge WebView2 Runtime. Every window a human sees on a club
    machine is WebView2 — the setup wizard the agent MSI launches, Organization Admin, the player
    shell. Without it the MSIs refused to install at all and told the cashier to go find the
    runtime themselves, in English. Now the bundle installs it.

    Unlike the .NET runtime, WebView2 is NOT carried whole: the offline installer is ~150 MB and
    Microsoft publishes it only behind rotating links, while the official Evergreen bootstrapper
    is ~2 MB and pulls the runtime itself. The bundle carries that bootstrapper (verified at build
    time by its Microsoft Authenticode signature — a SHA pin is impossible on an evergreen link),
    so a club with internet gets the runtime without touching anything. A machine with no internet
    at all cannot get WebView2 this way — but it also cannot reach the AFK4 cloud, which the agent
    needs from its first heartbeat.
  -->
  <Bundle
      Name="AFK4.NET"
      Manufacturer="AFK4.NET"
      Version="$(var.PackageVersion)"
      Compressed="yes"
      IconSourceFile="$(var.BrandIconPath)"
      UpgradeCode="{8E2C4A91-7B3D-4F6A-9C1E-2D5A8B0F3471}">

    <!--
      LogoFile brands the bootstrapper window with the AFK4 mark. The AFK4.BAFunctions
      payload (bal:BAFunctions) plugs into WixStdBA to auto-start the install and
      auto-close on success, so the only prompt the user sees is Windows' UAC. It's a
      tiny native, statically-linked DLL (no .NET/VC++ runtime needed) — see
      installers/bundle/bafunctions/.
    -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" SuppressOptionsUI="yes" LogoFile="$(var.BrandLogoPath)" />
      <Payload Id="AfkBAFunctions" SourceFile="$(var.BAFunctionsPath)" bal:BAFunctions="yes" />
    </BootstrapperApplication>

    <!--
      WebView2 registers its version under EdgeUpdate: per-machine installs normally land in the
      32-bit view (WOW6432Node) even on x64, but a 64-bit registration exists too, and a per-user
      install lands under HKCU. "0.0.0.0" means the key is there and the runtime is not. All three
      keys are checked here, in the component MSIs and in the update helper — one answer to
      "is WebView2 here?" everywhere.
    -->
    <util:RegistrySearch
        Id="WebView2RuntimeHklmPv"
        Root="HKLM"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="value"
        Variable="WebView2RuntimeHklmPv" />
    <util:RegistrySearch
        Id="WebView2RuntimeHklm64Pv"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="value"
        Variable="WebView2RuntimeHklm64Pv" />
    <util:RegistrySearch
        Id="WebView2RuntimeHkcuPv"
        Root="HKCU"
        Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="value"
        Variable="WebView2RuntimeHkcuPv" />

    <!--
      Тихая установка по коду: `afk4-client.exe /quiet AFK4_INSTALL_CODE=… [AFK4_SEAT=…]`. Burn
      пускает с командной строки только переменные, помеченные Overridable; код Hidden — его
      значения нет в журнале установщика. Дальше обе едут в MSI агента одноимёнными свойствами.
    -->
    <Variable Name="AFK4_INSTALL_CODE" bal:Overridable="yes" Hidden="yes" Value="" />
    <Variable Name="AFK4_SEAT" bal:Overridable="yes" Value="" />

    <netfx:DotNetCoreSearch
        Id="DesktopRuntime10"
        RuntimeType="desktop"
        Platform="x64"
        MajorVersion="10"
        Variable="DesktopRuntime10Version" />

    <Chain>
      <!--
        The runtime is embedded because the Bundle itself is Compressed="yes" (all payloads
        default to compressed/embedded). Compressed must NOT also sit on the ExePackage when an
        ExePackagePayload child is present (WIX0372), and ProductName/Description on the payload
        require a Hash/cert (WIX0037) — both are dropped: the runtime's own installer identifies
        itself, and it runs /quiet anyway.
      -->
      <ExePackage
          DetectCondition="DesktopRuntime10Version AND DesktopRuntime10Version &gt;= v$(var.RuntimeVersion)"
          Permanent="yes"
          Vital="yes"
          PerMachine="yes"
          InstallArguments="/install /quiet /norestart"
          RepairArguments="/repair /quiet /norestart"
          UninstallArguments="/uninstall /quiet /norestart"
          bal:PrereqPackage="yes">
        <ExePackagePayload
            Name="windowsdesktop-runtime-$(var.RuntimeVersion)-win-x64.exe"
            SourceFile="$(var.RuntimeInstallerPath)" />
      </ExePackage>

      <!--
        WebView2 goes before the agent MSI: that MSI ends by launching the setup wizard, and the
        wizard is a WebView2 window. Permanent because the runtime is shared with everything else
        on the machine — uninstalling AFK4 must not take Edge WebView2 away from other software.
      -->
      <ExePackage
          DetectCondition="(WebView2RuntimeHklmPv AND WebView2RuntimeHklmPv &lt;&gt; &quot;0.0.0.0&quot;) OR (WebView2RuntimeHklm64Pv AND WebView2RuntimeHklm64Pv &lt;&gt; &quot;0.0.0.0&quot;) OR (WebView2RuntimeHkcuPv AND WebView2RuntimeHkcuPv &lt;&gt; &quot;0.0.0.0&quot;)"
          Permanent="yes"
          Vital="yes"
          PerMachine="yes"
          InstallArguments="/silent /install"
          RepairArguments="/silent /install"
          bal:PrereqPackage="yes">
        <ExePackagePayload
            Name="MicrosoftEdgeWebview2Setup.exe"
            SourceFile="$(var.WebView2BootstrapperPath)" />
      </ExePackage>

      <!-- LAUNCHWIZARD=1 makes the agent MSI auto-launch the Setup Wizard even though Burn
           runs it at UILevel=none; see the LaunchSetupWizard condition in installers/agent/Package.wxs. -->
      <MsiPackage SourceFile="$(var.AgentMsiPath)" Vital="yes">
        <MsiProperty Name="LAUNCHWIZARD" Value="1" />
        <MsiProperty Name="AFK4_INSTALL_CODE" Value="[AFK4_INSTALL_CODE]" />
        <MsiProperty Name="AFK4_SEAT" Value="[AFK4_SEAT]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
