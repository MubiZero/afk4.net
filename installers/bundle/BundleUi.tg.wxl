<?xml version="1.0" encoding="utf-8"?>
<!--
  Тексты окна установщика (WixStdBA) на таджикском (кириллица, tg-Cyrl-TJ, LCID 1064). Бандл
  кладёт файл в папку 1064\thm.wxl: WixStdBA ищет там язык, который Windows считает
  предпочитаемым для пользователя, и берёт русский thm.wxl, если такой папки нет. Принудительно:
  afk4-client.exe /lang 1064. Набор Id — тот же, что в BundleUi.ru.wxl (следит тест).
  Ширина кнопок в теме фиксирована (75 пикселей), поэтому подписи короткие.
-->
<WixLocalization Culture="tg-Cyrl-TJ" Language="1064" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Насби [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Санҷиши навсозиҳо" />
  <String Id="UpdateButton" Value="&amp;Навсозӣ ба версияи [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Хуш омадед" />
  <String Id="InstallMessage" Value="Барнома [WixBundleName]-ро дар ин компютер насб мекунад. Барои идома додан «Насб кардан»-ро пахш кунед ё барои баромадан «Бекор»-ро." />
  <String Id="InstallMessageOptions" Value="Барнома [WixBundleName]-ро дар ин компютер насб мекунад. Барои идома додан «Насб кардан»-ро, барои тағйири танзимоти насб «Танзимот»-ро ва барои баромадан «Бекор»-ро пахш кунед." />
  <String Id="InstallVersion" Value="Версияи [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Насбро қатъ мекунед?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Версияи пешина" />
  <String Id="HelpHeader" Value="Роҳнамои насб" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [ҷузвдон] - насб кардан, ислоҳ кардан, нест кардан ё&#xA;   дар ҷузвдон сохтани нусхаи пурраи маҳаллии насбкунак. Одатан насб иҷро мешавад.&#xA;&#xA;/passive | /quiet - камтарин равзанаҳоро бе саволҳо нишон додан ё ҳеҷ чиз нишон надодан.&#xA;   Одатан ҳамаи равзанаҳо ва саволҳо нишон дода мешаванд.&#xA;&#xA;/norestart   - компютерро аз нав оғоз накардан. Одатан пеш аз аз нав оғоз кардан савол дода мешавад.&#xA;/log log.txt - сабти рафтро ба файли додашуда навиштан. Одатан сабт дар %TEMP% мемонад.&#xA;/lang 1064 - равзанаро ба забони тоҷикӣ нишон додан (1049 - ба русӣ)." />
  <String Id="HelpCloseButton" Value="&amp;Пӯшидан" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName]: &lt;a href=&quot;#&quot;&gt;шартҳои иҷозатнома&lt;/a&gt;." />
  <String Id="InstallAcceptCheckbox" Value="Ман бо шартҳои иҷозатнома &amp;розӣ ҳастам" />
  <String Id="InstallOptionsButton" Value="&amp;Танзимот" />
  <String Id="InstallInstallButton" Value="&amp;Насб кардан" />
  <String Id="InstallCancelButton" Value="&amp;Бекор" />
