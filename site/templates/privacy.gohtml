{{define "main"}}{{with .C.Privacy}}    <section class="section">
      <div class="wrap narrow">
        <h1 class="page-title">{{.Title}}</h1>
        <p class="note">{{.Updated}}</p>{{range .Sections}}
        <h2>{{.Title}}</h2>
        <p>{{.Body}}</p>{{end}}
      </div>
    </section>{{end}}{{end}}
